{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azerckid.github.io/SCAN/schemas/analysis-request.schema.json",
  "title": "SCAN Analysis Request 0.2 (0.1 compatible)",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "analysis_id",
    "analysis_type",
    "chain_id",
    "inputs",
    "source_policy",
    "requested_at"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "analysis-request\\.schema\\.json$"
    },
    "schema_version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "analysis_id": {
      "$ref": "#/$defs/analysisId"
    },
    "analysis_type": {
      "$ref": "#/$defs/analysisType"
    },
    "query_kind": {
      "enum": [
        "object_summary",
        "historical_balance",
        "first_token_transfer",
        "native_inflow",
        "nft_activity",
        "proxy_history",
        "trace_path",
        "trace_remerge",
        "aggregate_origins",
        "collect_label_claims",
        "check_sanctions_exposure",
        "resolve_identity_clues",
        "find_common_funder",
        "score_actor_relations",
        "link_bridge_transfer",
        "summarize_transaction",
        "assess_heuristics",
        "evaluate_cex_cluster",
        "reconstruct_incident"
      ]
    },
    "chain_id": {"enum": [0, 1]},
    "fixture_id": {
      "type": "string",
      "pattern": "^FX-[A-Z0-9-]+$"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "object"
    },
    "source_policy": {
      "$ref": "#/$defs/sourcePolicy"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"analysis_type": {"const": "bitcoin_utxo"}},
        "required": ["analysis_type"]
      },
      "then": {
        "properties": {
          "schema_version": {"const": "0.2"},
          "chain_id": {"const": 0},
          "query_kind": {"enum": ["summarize_transaction", "assess_heuristics"]}
        },
        "required": ["query_kind"]
      },
      "else": {"properties": {"chain_id": {"const": 1}}}
    },
    {
      "if": {
        "properties": {
          "analysis_type": {
            "const": "dex_swap"
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "not": {
          "required": [
            "query_kind"
          ]
        },
        "properties": {
          "schema_version": {
            "const": "0.1"
          },
          "inputs": {
            "$ref": "#/$defs/dexInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_type": {
            "const": "auth_consumption"
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "not": {
          "required": [
            "query_kind"
          ]
        },
        "properties": {
          "schema_version": {
            "const": "0.1"
          },
          "inputs": {
            "$ref": "#/$defs/authInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_type": {
            "const": "address_freeze"
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "not": {
          "required": [
            "query_kind"
          ]
        },
        "properties": {
          "schema_version": {
            "const": "0.1"
          },
          "inputs": {
            "$ref": "#/$defs/freezeInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_type": {
            "const": "evm_core"
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "required": [
          "query_kind"
        ],
        "properties": {
          "schema_version": {
            "const": "0.2"
          },
          "query_kind": {
            "enum": [
              "object_summary",
              "historical_balance",
              "first_token_transfer",
              "native_inflow"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_type": {
            "const": "evm_special"
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "required": [
          "query_kind"
        ],
        "properties": {
          "schema_version": {
            "const": "0.2"
          },
          "query_kind": {
            "enum": [
              "nft_activity",
              "proxy_history"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_type": {
            "const": "flow_path"
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "required": [
          "query_kind"
        ],
        "properties": {
          "schema_version": {
            "const": "0.2"
          },
          "query_kind": {
            "enum": [
              "trace_path",
              "trace_remerge",
              "aggregate_origins"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_type": {
            "const": "intel_context"
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "required": [
          "query_kind"
        ],
        "properties": {
          "schema_version": {
            "const": "0.2"
          },
          "query_kind": {
            "enum": [
              "collect_label_claims",
              "check_sanctions_exposure",
              "resolve_identity_clues",
              "find_common_funder",
              "score_actor_relations"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_type": {
            "const": "bridge_transfer"
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "required": [
          "query_kind"
        ],
        "properties": {
          "schema_version": {
            "const": "0.2"
          },
          "query_kind": {
            "const": "link_bridge_transfer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_type": {
            "const": "cex_cluster"
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "required": [
          "query_kind"
        ],
        "properties": {
          "schema_version": {
            "const": "0.2"
          },
          "query_kind": {
            "const": "evaluate_cex_cluster"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_type": {
            "const": "case_reconciliation"
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "required": [
          "query_kind"
        ],
        "properties": {
          "schema_version": {
            "const": "0.2"
          },
          "query_kind": {
            "const": "reconstruct_incident"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_kind": {
            "const": "object_summary"
          }
        },
        "required": [
          "query_kind"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/objectSummaryInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_kind": {
            "const": "historical_balance"
          }
        },
        "required": [
          "query_kind"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/historicalBalanceInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_kind": {
            "const": "first_token_transfer"
          }
        },
        "required": [
          "query_kind"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/firstTokenTransferInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_kind": {
            "const": "native_inflow"
          }
        },
        "required": [
          "query_kind"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/nativeInflowInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_kind": {
            "const": "nft_activity"
          }
        },
        "required": [
          "query_kind"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/nftActivityInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_kind": {
            "const": "proxy_history"
          }
        },
        "required": [
          "query_kind"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/proxyHistoryInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_kind": {
            "const": "link_bridge_transfer"
          }
        },
        "required": [
          "query_kind"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/linkBridgeTransferInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {"query_kind": {"const": "summarize_transaction"}},
        "required": ["query_kind"]
      },
      "then": {"properties": {"inputs": {"$ref": "#/$defs/bitcoinTransactionInputs"}}}
    },
    {
      "if": {
        "properties": {"query_kind": {"const": "assess_heuristics"}},
        "required": ["query_kind"]
      },
      "then": {"properties": {"inputs": {"$ref": "#/$defs/bitcoinHeuristicInputs"}}}
    },
    {
      "if": {
        "properties": {
          "query_kind": {
            "const": "evaluate_cex_cluster"
          }
        },
        "required": [
          "query_kind"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/evaluateCexClusterInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_kind": {
            "const": "reconstruct_incident"
          }
        },
        "required": [
          "query_kind"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/reconstructIncidentInputs"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "analysisId": {
      "type": "string",
      "pattern": "^AN-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "analysisType": {
      "enum": [
        "dex_swap",
        "auth_consumption",
        "address_freeze",
        "evm_core",
        "evm_special",
        "flow_path",
        "intel_context",
        "bridge_transfer",
        "bitcoin_utxo",
        "cex_cluster",
        "case_reconciliation"
      ]
    },
    "address": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{40}$"
    },
    "transactionHash": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "bitcoinTxId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^DS-[A-Z0-9-]+$"
    },
    "authStateBlocks": {
      "type": "object",
      "required": [
        "before_approval",
        "after_approval",
        "before_consumption",
        "after_consumption"
      ],
      "properties": {
        "before_approval": {
          "type": "integer",
          "minimum": 0
        },
        "after_approval": {
          "type": "integer",
          "minimum": 0
        },
        "before_consumption": {
          "type": "integer",
          "minimum": 0
        },
        "after_consumption": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "freezeStateBlocks": {
      "type": "object",
      "required": [
        "before_blacklist",
        "after_blacklist",
        "before_unblacklist",
        "after_unblacklist"
      ],
      "properties": {
        "before_blacklist": {
          "type": "integer",
          "minimum": 0
        },
        "after_blacklist": {
          "type": "integer",
          "minimum": 0
        },
        "before_unblacklist": {
          "type": "integer",
          "minimum": 0
        },
        "after_unblacklist": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "dexInputs": {
      "type": "object",
      "required": [
        "transaction_hash"
      ],
      "properties": {
        "transaction_hash": {
          "$ref": "#/$defs/transactionHash"
        }
      },
      "additionalProperties": false
    },
    "authInputs": {
      "type": "object",
      "required": [
        "subject_address",
        "token_address",
        "spender_address",
        "approval_transaction_hash",
        "consumption_transaction_hash",
        "state_blocks"
      ],
      "properties": {
        "subject_address": {
          "$ref": "#/$defs/address"
        },
        "token_address": {
          "$ref": "#/$defs/address"
        },
        "spender_address": {
          "$ref": "#/$defs/address"
        },
        "approval_type": {
          "enum": [
            "approve",
            "permit",
            "permit2"
          ]
        },
        "approval_transaction_hash": {
          "$ref": "#/$defs/transactionHash"
        },
        "consumption_transaction_hash": {
          "$ref": "#/$defs/transactionHash"
        },
        "state_blocks": {
          "$ref": "#/$defs/authStateBlocks"
        },
        "excluded_transaction_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transactionHash"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "freezeInputs": {
      "type": "object",
      "required": [
        "token_address",
        "target_address",
        "mode",
        "event_transaction_hashes",
        "state_blocks"
      ],
      "properties": {
        "token_address": {
          "$ref": "#/$defs/address"
        },
        "target_address": {
          "$ref": "#/$defs/address"
        },
        "mode": {
          "const": "address_blacklist_lifecycle"
        },
        "event_transaction_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transactionHash"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "state_blocks": {
          "$ref": "#/$defs/freezeStateBlocks"
        },
        "context_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "balanceAsset": {
      "type": "object",
      "required": [
        "asset_type",
        "symbol"
      ],
      "properties": {
        "asset_type": {
          "enum": [
            "native",
            "erc20"
          ]
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}$"
        },
        "token_address": {
          "$ref": "#/$defs/address"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "erc20"
              }
            }
          },
          "then": {
            "required": [
              "token_address"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "native"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "token_address"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "objectSummaryInputs": {
      "type": "object",
      "required": [
        "values",
        "block_number",
        "include_transaction_fee"
      ],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "block_number": {
          "type": "integer",
          "minimum": 0
        },
        "include_transaction_fee": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "historicalBalanceInputs": {
      "type": "object",
      "required": [
        "subject_address",
        "block_number",
        "block_timestamp",
        "state_semantics",
        "assets"
      ],
      "properties": {
        "subject_address": {
          "$ref": "#/$defs/address"
        },
        "block_number": {
          "type": "integer",
          "minimum": 0
        },
        "block_timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "state_semantics": {
          "const": "post_state"
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/balanceAsset"
          }
        }
      },
      "additionalProperties": false
    },
    "firstTokenTransferInputs": {
      "type": "object",
      "required": [
        "subject_address",
        "token_address",
        "start_block",
        "direction",
        "exclude_zero",
        "require_success",
        "ordering"
      ],
      "properties": {
        "subject_address": {
          "$ref": "#/$defs/address"
        },
        "token_address": {
          "$ref": "#/$defs/address"
        },
        "start_block": {
          "type": "integer",
          "minimum": 0
        },
        "direction": {
          "const": "outgoing"
        },
        "exclude_zero": {
          "const": true
        },
        "require_success": {
          "const": true
        },
        "ordering": {
          "const": "block_transaction_log_asc"
        }
      },
      "additionalProperties": false
    },
    "nativeInflowInputs": {
      "type": "object",
      "required": [
        "interest_address",
        "transaction_hash",
        "require_trace",
        "exclude_reverted"
      ],
      "properties": {
        "interest_address": {
          "$ref": "#/$defs/address"
        },
        "transaction_hash": {
          "$ref": "#/$defs/transactionHash"
        },
        "require_trace": {
          "const": true
        },
        "exclude_reverted": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "nftActivityInputs": {
      "type": "object",
      "required": [
        "token_contract",
        "subject_address",
        "standard_hint",
        "include_approvals"
      ],
      "properties": {
        "token_contract": {
          "$ref": "#/$defs/address"
        },
        "subject_address": {
          "$ref": "#/$defs/address"
        },
        "standard_hint": {
          "enum": [
            "erc721",
            "erc1155",
            "auto"
          ]
        },
        "include_approvals": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "proxyHistoryInputs": {
      "type": "object",
      "required": [
        "proxy_address",
        "pattern_hint",
        "include_admin",
        "include_beacon"
      ],
      "properties": {
        "proxy_address": {
          "$ref": "#/$defs/address"
        },
        "pattern_hint": {
          "enum": [
            "eip1967",
            "auto"
          ]
        },
        "include_admin": {
          "type": "boolean"
        },
        "include_beacon": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "linkBridgeTransferInputs": {
      "type": "object",
      "required": [
        "source_subject",
        "destination_chain_id",
        "origin_chain_id"
      ],
      "properties": {
        "source_subject": {
          "$ref": "#/$defs/address"
        },
        "destination_chain_id": {
          "type": "integer"
        },
        "origin_chain_id": {
          "type": "integer"
        },
        "expected_recipient": {
          "$ref": "#/$defs/address"
        },
        "source_transaction_hash": {
          "$ref": "#/$defs/transactionHash"
        },
        "destination_transaction_hash": {
          "$ref": "#/$defs/transactionHash"
        }
      },
      "additionalProperties": false
    },
    "bitcoinTransactionInputs": {
      "type": "object",
      "required": ["transaction_id", "network", "start_vout", "max_hops"],
      "properties": {
        "transaction_id": {"$ref": "#/$defs/bitcoinTxId"},
        "network": {"const": "bitcoin_mainnet"},
        "start_vout": {"type": "integer", "minimum": 0},
        "max_hops": {"type": "integer", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "bitcoinHeuristicInputs": {
      "type": "object",
      "required": ["transaction_id", "network", "start_vout", "max_hops", "assess_change", "assess_coinjoin"],
      "properties": {
        "transaction_id": {"$ref": "#/$defs/bitcoinTxId"},
        "network": {"const": "bitcoin_mainnet"},
        "start_vout": {"type": "integer", "minimum": 0},
        "max_hops": {"type": "integer", "exclusiveMinimum": 0},
        "assess_change": {"type": "boolean"},
        "assess_coinjoin": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "observationWindowInputs": {
      "type": "object",
      "required": [
        "start_block",
        "end_block"
      ],
      "properties": {
        "start_block": {
          "type": "integer",
          "minimum": 0
        },
        "end_block": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "evaluateCexClusterInputs": {
      "type": "object",
      "required": [
        "deposit_candidates",
        "observation_window"
      ],
      "properties": {
        "deposit_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "observation_window": {
          "$ref": "#/$defs/observationWindowInputs"
        },
        "expected_hot_wallet": {
          "$ref": "#/$defs/address"
        }
      },
      "additionalProperties": false
    },
    "reconstructIncidentInputs": {
      "type": "object",
      "required": [
        "case_category",
        "seed_transaction_hash",
        "source_fixture_refs",
        "max_timeline_entries"
      ],
      "properties": {
        "case_category": {
          "enum": ["phishing", "address_poisoning", "exploit", "rug_pull", "mixed"]
        },
        "seed_transaction_hash": {
          "$ref": "#/$defs/transactionHash"
        },
        "source_fixture_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FX-[A-Z0-9-]+$"
          }
        },
        "max_timeline_entries": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "sourcePolicy": {
      "type": "object",
      "required": [
        "rule_status",
        "allowed_source_ids",
        "source_order",
        "allow_fallback",
        "offline_mode"
      ],
      "properties": {
        "rule_status": {
          "enum": [
            "unconfirmed",
            "allowed",
            "restricted"
          ]
        },
        "allowed_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allow_fallback": {
          "type": "boolean"
        },
        "offline_mode": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
