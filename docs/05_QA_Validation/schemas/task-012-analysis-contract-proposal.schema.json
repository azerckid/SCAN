{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azerckid.github.io/SCAN/schemas/task-012-analysis-contract-proposal.schema.json",
  "title": "TASK-012 EVM Core Analysis Contract Proposal 0.2",
  "type": "object",
  "required": [
    "proposal_version",
    "status",
    "analysis_type",
    "cases"
  ],
  "properties": {
    "proposal_version": {
      "const": "0.2-draft"
    },
    "status": {
      "const": "proposed"
    },
    "analysis_type": {
      "const": "evm_core"
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "analysisId": {
      "type": "string",
      "pattern": "^AN-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "fixtureId": {
      "enum": [
        "FX-BASIC-EVM-001",
        "FX-BASIC-EVM-002",
        "FX-EVM-TOKEN-001",
        "FX-EVM-TOKEN-002"
      ]
    },
    "queryKind": {
      "enum": [
        "object_summary",
        "historical_balance",
        "first_token_transfer",
        "native_inflow"
      ]
    },
    "address": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{40}$"
    },
    "transactionHash": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "uint256": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^DS-[A-Z0-9-]+$"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "stage",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_input",
            "unsupported_chain",
            "source_unavailable",
            "rate_limited",
            "archive_required",
            "trace_unavailable",
            "decode_failed",
            "evidence_incomplete",
            "reconciliation_failed",
            "schema_invalid",
            "rule_restricted"
          ]
        },
        "stage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "sourcePolicy": {
      "type": "object",
      "required": [
        "rule_status",
        "allowed_source_ids",
        "source_order",
        "allow_fallback",
        "offline_mode"
      ],
      "properties": {
        "rule_status": {
          "enum": [
            "unconfirmed",
            "allowed",
            "restricted"
          ]
        },
        "allowed_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        },
        "source_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        },
        "allow_fallback": {
          "type": "boolean"
        },
        "offline_mode": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "objectInputs": {
      "type": "object",
      "required": [
        "values",
        "block_number",
        "include_transaction_fee"
      ],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "block_number": {
          "type": "integer",
          "minimum": 0
        },
        "include_transaction_fee": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "balanceInputs": {
      "type": "object",
      "required": [
        "subject_address",
        "block_number",
        "block_timestamp",
        "state_semantics",
        "assets"
      ],
      "properties": {
        "subject_address": {
          "$ref": "#/$defs/address"
        },
        "block_number": {
          "type": "integer",
          "minimum": 0
        },
        "block_timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "state_semantics": {
          "const": "post_state"
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "asset_type",
              "symbol"
            ],
            "properties": {
              "asset_type": {
                "enum": [
                  "native",
                  "erc20"
                ]
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "token_address": {
                "$ref": "#/$defs/address"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "transferInputs": {
      "type": "object",
      "required": [
        "subject_address",
        "token_address",
        "start_block",
        "direction",
        "exclude_zero",
        "require_success",
        "ordering"
      ],
      "properties": {
        "subject_address": {
          "$ref": "#/$defs/address"
        },
        "token_address": {
          "$ref": "#/$defs/address"
        },
        "start_block": {
          "type": "integer",
          "minimum": 0
        },
        "direction": {
          "const": "outgoing"
        },
        "exclude_zero": {
          "const": true
        },
        "require_success": {
          "const": true
        },
        "ordering": {
          "const": "block_transaction_log_asc"
        }
      },
      "additionalProperties": false
    },
    "inflowInputs": {
      "type": "object",
      "required": [
        "interest_address",
        "transaction_hash",
        "require_trace",
        "exclude_reverted"
      ],
      "properties": {
        "interest_address": {
          "$ref": "#/$defs/address"
        },
        "transaction_hash": {
          "$ref": "#/$defs/transactionHash"
        },
        "require_trace": {
          "const": true
        },
        "exclude_reverted": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "analysis_id",
        "analysis_type",
        "chain_id",
        "query_kind",
        "inputs",
        "source_policy"
      ],
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/analysisId"
        },
        "analysis_type": {
          "const": "evm_core"
        },
        "chain_id": {
          "const": 1
        },
        "query_kind": {
          "$ref": "#/$defs/queryKind"
        },
        "inputs": {
          "type": "object"
        },
        "source_policy": {
          "$ref": "#/$defs/sourcePolicy"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "query_kind": {
                "const": "object_summary"
              }
            },
            "required": [
              "query_kind"
            ]
          },
          "then": {
            "properties": {
              "inputs": {
                "$ref": "#/$defs/objectInputs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "query_kind": {
                "const": "historical_balance"
              }
            },
            "required": [
              "query_kind"
            ]
          },
          "then": {
            "properties": {
              "inputs": {
                "$ref": "#/$defs/balanceInputs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "query_kind": {
                "const": "first_token_transfer"
              }
            },
            "required": [
              "query_kind"
            ]
          },
          "then": {
            "properties": {
              "inputs": {
                "$ref": "#/$defs/transferInputs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "query_kind": {
                "const": "native_inflow"
              }
            },
            "required": [
              "query_kind"
            ]
          },
          "then": {
            "properties": {
              "inputs": {
                "$ref": "#/$defs/inflowInputs"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "objectData": {
      "type": "object",
      "required": [
        "objects"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "input",
              "classification"
            ],
            "properties": {
              "input": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "classification": {
                "enum": [
                  "address",
                  "transaction_hash",
                  "block_hash",
                  "block_number",
                  "invalid"
                ]
              },
              "account_kind": {
                "enum": [
                  "eoa",
                  "contract"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "fee_paid_wei": {
          "$ref": "#/$defs/uint256"
        }
      },
      "additionalProperties": false
    },
    "balanceData": {
      "type": "object",
      "required": [
        "block_number",
        "block_timestamp",
        "state_semantics",
        "balances"
      ],
      "properties": {
        "block_number": {
          "type": "integer",
          "minimum": 0
        },
        "block_timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "state_semantics": {
          "const": "post_state"
        },
        "balances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "symbol",
              "amount_raw"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "token_address": {
                "$ref": "#/$defs/address"
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "amount_raw": {
                "$ref": "#/$defs/uint256"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "transferData": {
      "type": "object",
      "required": [
        "range_complete",
        "transfer"
      ],
      "properties": {
        "range_complete": {
          "type": "boolean"
        },
        "transfer": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "transaction_hash",
                "block_number",
                "transaction_index",
                "log_index",
                "token_address",
                "from",
                "to",
                "amount_raw"
              ],
              "properties": {
                "transaction_hash": {
                  "$ref": "#/$defs/transactionHash"
                },
                "block_number": {
                  "type": "integer",
                  "minimum": 0
                },
                "transaction_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "log_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "token_address": {
                  "$ref": "#/$defs/address"
                },
                "from": {
                  "$ref": "#/$defs/address"
                },
                "to": {
                  "$ref": "#/$defs/address"
                },
                "amount_raw": {
                  "$ref": "#/$defs/uint256"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "inflowData": {
      "type": "object",
      "required": [
        "top_level_value_wei",
        "internal_inflow_wei",
        "successful_call_count",
        "trace_complete"
      ],
      "properties": {
        "top_level_value_wei": {
          "$ref": "#/$defs/uint256"
        },
        "internal_inflow_wei": {
          "$ref": "#/$defs/uint256"
        },
        "successful_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "trace_complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "analysis_id",
        "analysis_type",
        "chain_id",
        "query_kind",
        "status",
        "data",
        "errors",
        "evidence_refs",
        "source_record_refs"
      ],
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/analysisId"
        },
        "analysis_type": {
          "const": "evm_core"
        },
        "chain_id": {
          "const": 1
        },
        "query_kind": {
          "$ref": "#/$defs/queryKind"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "data": {
          "type": [
            "object",
            "null"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EV-[A-Z0-9-]+$"
          }
        },
        "source_record_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object"
              },
              "errors": {
                "maxItems": 0
              },
              "evidence_refs": {
                "minItems": 1
              },
              "source_record_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object"
              },
              "errors": {
                "minItems": 1
              },
              "evidence_refs": {
                "minItems": 1
              },
              "source_record_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "null"
              },
              "errors": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "query_kind": {
                "const": "object_summary"
              },
              "status": {
                "enum": [
                  "complete",
                  "partial"
                ]
              }
            },
            "required": [
              "query_kind",
              "status"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/objectData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "query_kind": {
                "const": "historical_balance"
              },
              "status": {
                "enum": [
                  "complete",
                  "partial"
                ]
              }
            },
            "required": [
              "query_kind",
              "status"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/balanceData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "query_kind": {
                "const": "first_token_transfer"
              },
              "status": {
                "enum": [
                  "complete",
                  "partial"
                ]
              }
            },
            "required": [
              "query_kind",
              "status"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/transferData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "query_kind": {
                "const": "native_inflow"
              },
              "status": {
                "enum": [
                  "complete",
                  "partial"
                ]
              }
            },
            "required": [
              "query_kind",
              "status"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/inflowData"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "fixture_id",
        "scenario",
        "request",
        "result"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^CASE-EVM-[A-Z0-9-]+$"
        },
        "fixture_id": {
          "$ref": "#/$defs/fixtureId"
        },
        "scenario": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "result": {
          "$ref": "#/$defs/result"
        }
      },
      "additionalProperties": false
    }
  }
}
