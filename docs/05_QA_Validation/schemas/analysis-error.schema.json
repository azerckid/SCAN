{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azerckid.github.io/SCAN/schemas/analysis-error.schema.json",
  "title": "SCAN Analysis Error 0.1",
  "type": "object",
  "required": [
    "error_id",
    "code",
    "message",
    "stage",
    "retryable",
    "attempt_count"
  ],
  "properties": {
    "error_id": {
      "type": "string",
      "pattern": "^ERR-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "code": {
      "enum": [
        "invalid_input",
        "unsupported_chain",
        "source_unavailable",
        "rate_limited",
        "archive_required",
        "trace_unavailable",
        "decode_failed",
        "evidence_incomplete",
        "reconciliation_failed",
        "schema_invalid",
        "rule_restricted"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "source_id": {
      "$ref": "#/$defs/sourceId"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "retryable": {
      "type": "boolean"
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "related_evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceId"
      },
      "uniqueItems": true
    },
    "details": {
      "type": "object",
      "description": "Redacted, machine-readable diagnostic details.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sourceId": {
      "type": "string",
      "pattern": "^DS-[A-Z0-9-]+$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^EV-[A-Z0-9][A-Z0-9-]{2,127}$"
    }
  }
}
