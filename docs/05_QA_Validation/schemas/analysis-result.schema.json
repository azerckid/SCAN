{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azerckid.github.io/SCAN/schemas/analysis-result.schema.json",
  "title": "SCAN Analysis Result 0.2 (0.1 compatible)",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "analysis_id",
    "analysis_type",
    "chain_id",
    "status",
    "results",
    "evidence",
    "sources",
    "warnings",
    "errors",
    "run",
    "exports"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "analysis-result\\.schema\\.json$"
    },
    "schema_version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "analysis_id": {
      "$ref": "#/$defs/analysisId"
    },
    "analysis_type": {
      "$ref": "#/$defs/analysisType"
    },
    "chain_id": {
      "enum": [
        0,
        1
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "analysis-error.schema.json"
      }
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "exports": {
      "$ref": "#/$defs/exports"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "analysis_type": {
            "enum": [
              "evm_core",
              "evm_special",
              "flow_path",
              "intel_context",
              "bridge_transfer",
              "bitcoin_utxo",
              "cex_cluster",
              "mixer_flow",
              "defi_lending",
              "case_reconciliation"
            ]
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "0.2"
          }
        }
      },
      "else": {
        "properties": {
          "schema_version": {
            "const": "0.1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_type": {
            "const": "bitcoin_utxo"
          }
        },
        "required": [
          "analysis_type"
        ]
      },
      "then": {
        "properties": {
          "chain_id": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "chain_id": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1
          },
          "sources": {
            "minItems": 1
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1
          },
          "sources": {
            "minItems": 1
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "analysisId": {
      "type": "string",
      "pattern": "^AN-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "analysisType": {
      "enum": [
        "dex_swap",
        "auth_consumption",
        "address_freeze",
        "evm_core",
        "evm_special",
        "flow_path",
        "intel_context",
        "bridge_transfer",
        "bitcoin_utxo",
        "cex_cluster",
        "mixer_flow",
        "defi_lending",
        "case_reconciliation"
      ]
    },
    "resultId": {
      "type": "string",
      "pattern": "^RES-[A-Z0-9][A-Z0-9-]{2,127}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^EV-[A-Z0-9][A-Z0-9-]{2,127}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^DS-[A-Z0-9-]+$"
    },
    "sourceRecordId": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9][A-Z0-9-]{2,127}$"
    },
    "transactionHash": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "result": {
      "type": "object",
      "required": [
        "result_id",
        "result_type",
        "classification",
        "value",
        "tool_requirement_ids",
        "fixture_requirement_ids",
        "evidence_refs"
      ],
      "properties": {
        "result_id": {
          "$ref": "#/$defs/resultId"
        },
        "result_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "classification": {
          "enum": [
            "confirmed_fact",
            "external_context",
            "heuristic",
            "not_assessed"
          ]
        },
        "value": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "tool_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^REQ-(COM|P0|V1|NFR)-[A-Z0-9-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "fixture_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^REQ-(DEX|AUTH|FREEZE|BASIC|TOKEN|NFT721|NFT1155|PROXY|FLOW|INTEL|BRIDGE|BTC|CEX|MIX|LEND|CASE)-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceId"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_uri"
      ],
      "properties": {
        "artifact_uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "evidence_type",
        "source_id",
        "source_record_ref",
        "method",
        "retrieved_at",
        "locator",
        "decoded",
        "raw_artifact"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidenceId"
        },
        "evidence_type": {
          "enum": [
            "event",
            "call",
            "state",
            "context"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "source_record_ref": {
          "$ref": "#/$defs/sourceRecordId"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "locator": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "chain_id": {
              "type": "integer",
              "minimum": 0
            },
            "block_number": {
              "type": "integer",
              "minimum": 0
            },
            "transaction_hash": {
              "$ref": "#/$defs/transactionHash"
            },
            "log_index": {
              "type": "integer",
              "minimum": 0
            },
            "trace_address": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "decoded": {
          "type": "object",
          "additionalProperties": true
        },
        "raw_artifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "source_record_id",
        "source_id",
        "provider_id",
        "role",
        "required",
        "capability",
        "endpoint_host",
        "retrieved_at"
      ],
      "properties": {
        "source_record_id": {
          "$ref": "#/$defs/sourceRecordId"
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "role": {
          "enum": [
            "scoring",
            "context",
            "supporting"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_host": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "fallback_from": {
          "$ref": "#/$defs/sourceRecordId"
        }
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": [
        "warning_id",
        "code",
        "message"
      ],
      "properties": {
        "warning_id": {
          "type": "string",
          "pattern": "^WARN-[A-Z0-9][A-Z0-9-]{2,63}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "related_result_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resultId"
          },
          "uniqueItems": true
        },
        "related_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceId"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "tool_version",
        "execution_mode",
        "started_at",
        "finished_at",
        "cache_hits",
        "cache_misses",
        "retry_count",
        "fallback_count",
        "resumed"
      ],
      "properties": {
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "execution_mode": {
          "enum": [
            "live",
            "offline_replay",
            "fixture_example"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "cache_hits": {
          "type": "integer",
          "minimum": 0
        },
        "cache_misses": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_count": {
          "type": "integer",
          "minimum": 0
        },
        "resumed": {
          "type": "boolean"
        },
        "checkpoint_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "exportFile": {
      "type": "object",
      "required": [
        "artifact_uri"
      ],
      "properties": {
        "artifact_uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "exports": {
      "type": "object",
      "required": [
        "json",
        "markdown"
      ],
      "properties": {
        "json": {
          "$ref": "#/$defs/exportFile"
        },
        "markdown": {
          "$ref": "#/$defs/exportFile"
        },
        "csv": {
          "$ref": "#/$defs/exportFile"
        }
      },
      "additionalProperties": false
    }
  }
}
